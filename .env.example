# MongoDB Atlas
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=tailorbid

# Random 32+ char secrets
JWT_SECRET=
ENCRYPTION_KEY=   # encrypts stored OpenAI keys — do not change after keys are saved

# Cloudinary (submission screenshots)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ROOT_FOLDER=tailorbid

# Bootstrap OpenAI key; keys added on the admin API Keys page (MongoDB) always win
OPENAI_API_KEY=

# First admin — `npm run seed`, or auto-created on first login when no admin exists.
# Quote values containing '#'.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrator

# Email notifications via Resend (sign-up requests, approvals)
RESEND_API_KEY=
EMAIL_FROM="TailorBid <notifications@your-domain.com>"
EMAIL_ENABLED=1
APP_URL=https://callaborationandourlife.com

# Interview Assistant (assistant/, runs on your PC; reads this same file). Where the Interview Assistant button
# opens it and the port it listens on. Sites in APP_URL may connect it.
NEXT_PUBLIC_ASSISTANT_URL=http://127.0.0.1:4317
# Optional, assistant only: its models. Without TailorBid it uses OPENAI_API_KEY above.
ASSISTANT_MODEL=gpt-5.6-terra
ASSISTANT_REASONING_EFFORT=low
ASSISTANT_TRANSLATE_MODEL=gpt-6-luna
ASSISTANT_SERVICE_TIER=priority

# Vercel Cron: protects /api/cron/daily-report (Vercel sends it as a Bearer token)
CRON_SECRET=

# Web push (desktop notifications when TailorBid is closed). Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@your-domain.com
